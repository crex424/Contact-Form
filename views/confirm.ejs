<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="styles/contact-form.css">
    <title>Document</title>
</head>
<body>
    <%-include('partials/header.ejs') %>
    <main id="confirm-main">
        <div class="box">
            <h1 class="wallpoet" id="page-heading">Post Successful!</h1>
            <h2>Job posting summary </h2>
            <p><strong>First Name:</strong> <%= guest.fname %></p>
            <p><strong>Last Name:</strong> <%= guest.lname %></p>
            <p><strong>Job Title:</strong> <%= guest.jobTitle %></p>
            <p><strong>Company:</strong> <%= guest.company %></p>
            <p><strong>Linkedin:</strong> <%= guest.linkedin %></p>
            <p><strong>Email:</strong> <%= guest.email %></p>
            <p><strong>How we met:</strong> <%= guest.meet %></p>
            <p><strong>Other:</strong> <%= guest.other %></p>
            <p><strong>Message:</strong> <%= guest.message %></p>
            <p><strong>Add Me:</strong> <%= guest.mailingList %></p>
            <p><strong>Format:</strong> <%= guest.emailFormat %></p>
            <p><strong>Date and Time:</strong> <%= guest.timestamp.toLocaleString() %></p>

            <!-- <a href="/contact">
                <button type="submit" id="jobs-button">Contact Page</button>
            </a> -->
        </div>
    </main>
</body>
</html>