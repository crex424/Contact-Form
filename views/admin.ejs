<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="styles/contact-form.css">
    <!-- Scripts - jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/4.1.1/js/dataTables.responsive.min.js"></script>

    <title>Document</title>
</head>
<body id="contact-body">
    <%-include('partials/header.ejs') %>
    <main id="main-content">
        <table id="contact-table" class="display">
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Job Title</th>
                    <th>Company</th>
                    <th>Linkedin</th>
                    <th>Email</th>
                    <th>Meet Location</th>
                    <th>Other</th>
                    <th>Comment</th>
                    <th>Add to Mail List</th>
                    <th>Format</th>
                    <th>Post Date</th>
                </tr>
            </thead>
            <tbody>
                <% guests.forEach(guest => { %> 
                    <tr>
                        <td><%= guest.fname %></td>
                        <td><%= guest.lname %></td>
                        <td><%= guest.jobTitle %></td>
                        <td><%= guest.company %></td>
                        <td><%= guest.linkedin %></td>
                        <td><%= guest.email %></td>
                        <td> <%= guest.meet %></td>
                        <td><%= guest.other %></td>
                        <td><%= guest.message %></td>
                        <td><%= guest.mailingList %></td>
                        <td><%= guest.emailFormat %></td>
                        <td><%= guest.timestamp.toLocaleString() %></td>
                    </tr>

                <% }); %>
            </tbody>
        </table>
    </main>

    <script>
        new DataTable('#contact-table', {
            responsive: true
        });
    </script>
</body>
</html>